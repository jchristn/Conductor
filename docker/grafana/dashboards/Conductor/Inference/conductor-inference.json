{
  "uid": "conductor-inference",
  "title": "Conductor - Inference & Proxy",
  "tags": ["conductor", "inference"],
  "schemaVersion": 39,
  "version": 1,
  "refresh": "30s",
  "time": { "from": "now-6h", "to": "now" },
  "templating": {
    "list": [
      {
        "name": "api_family",
        "type": "query",
        "datasource": { "type": "prometheus", "uid": "prometheus" },
        "query": "label_values(conductor_inference_requests_total, api_family)",
        "includeAll": true,
        "multi": true,
        "current": { "text": "All", "value": "$__all" }
      }
    ]
  },
  "panels": [
    {
      "id": 1,
      "type": "stat",
      "title": "Inference rate",
      "gridPos": { "h": 6, "w": 6, "x": 0, "y": 0 },
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "fieldConfig": { "defaults": { "unit": "reqps" }, "overrides": [] },
      "targets": [
        { "refId": "A", "datasource": { "type": "prometheus", "uid": "prometheus" }, "expr": "sum(rate(conductor_inference_requests_total{api_family=~\"$api_family\"}[5m]))", "legendFormat": "req/s" }
      ]
    },
    {
      "id": 2,
      "type": "stat",
      "title": "Upstream errors",
      "gridPos": { "h": 6, "w": 6, "x": 6, "y": 0 },
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "fieldConfig": { "defaults": { "unit": "reqps", "thresholds": { "mode": "absolute", "steps": [ { "color": "green", "value": null }, { "color": "red", "value": 0.05 } ] } }, "overrides": [] },
      "targets": [
        { "refId": "A", "datasource": { "type": "prometheus", "uid": "prometheus" }, "expr": "sum(rate(conductor_inference_upstream_errors_total{api_family=~\"$api_family\"}[5m]))", "legendFormat": "errors/s" }
      ]
    },
    {
      "id": 3,
      "type": "stat",
      "title": "p95 total duration",
      "gridPos": { "h": 6, "w": 6, "x": 12, "y": 0 },
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "fieldConfig": { "defaults": { "unit": "s" }, "overrides": [] },
      "targets": [
        { "refId": "A", "datasource": { "type": "prometheus", "uid": "prometheus" }, "expr": "histogram_quantile(0.95, sum by (le) (rate(conductor_inference_request_duration_seconds_bucket{api_family=~\"$api_family\"}[5m])))", "legendFormat": "p95" }
      ]
    },
    {
      "id": 4,
      "type": "stat",
      "title": "p95 time to first token",
      "gridPos": { "h": 6, "w": 6, "x": 18, "y": 0 },
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "fieldConfig": { "defaults": { "unit": "s" }, "overrides": [] },
      "targets": [
        { "refId": "A", "datasource": { "type": "prometheus", "uid": "prometheus" }, "expr": "histogram_quantile(0.95, sum by (le) (rate(conductor_inference_first_token_duration_seconds_bucket{api_family=~\"$api_family\"}[5m])))", "legendFormat": "p95 TTFT" }
      ]
    },
    {
      "id": 5,
      "type": "timeseries",
      "title": "Request rate by API family",
      "gridPos": { "h": 8, "w": 12, "x": 0, "y": 6 },
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "fieldConfig": { "defaults": { "unit": "reqps", "custom": { "drawStyle": "line", "fillOpacity": 20, "stacking": { "mode": "normal" } } }, "overrides": [] },
      "targets": [
        { "refId": "A", "datasource": { "type": "prometheus", "uid": "prometheus" }, "expr": "sum by (api_family) (rate(conductor_inference_requests_total{api_family=~\"$api_family\"}[5m]))", "legendFormat": "{{api_family}}" }
      ]
    },
    {
      "id": 6,
      "type": "timeseries",
      "title": "Request rate by virtual model runner",
      "gridPos": { "h": 8, "w": 12, "x": 12, "y": 6 },
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "fieldConfig": { "defaults": { "unit": "reqps", "custom": { "drawStyle": "line", "fillOpacity": 10 } }, "overrides": [] },
      "targets": [
        { "refId": "A", "datasource": { "type": "prometheus", "uid": "prometheus" }, "expr": "sum by (vmr) (rate(conductor_inference_requests_total{api_family=~\"$api_family\"}[5m]))", "legendFormat": "{{vmr}}" }
      ]
    },
    {
      "id": 7,
      "type": "timeseries",
      "title": "End-to-end latency percentiles",
      "gridPos": { "h": 8, "w": 12, "x": 0, "y": 14 },
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "fieldConfig": { "defaults": { "unit": "s", "custom": { "drawStyle": "line", "fillOpacity": 0 } }, "overrides": [] },
      "targets": [
        { "refId": "A", "datasource": { "type": "prometheus", "uid": "prometheus" }, "expr": "histogram_quantile(0.50, sum by (le) (rate(conductor_inference_request_duration_seconds_bucket{api_family=~\"$api_family\"}[5m])))", "legendFormat": "p50" },
        { "refId": "B", "datasource": { "type": "prometheus", "uid": "prometheus" }, "expr": "histogram_quantile(0.95, sum by (le) (rate(conductor_inference_request_duration_seconds_bucket{api_family=~\"$api_family\"}[5m])))", "legendFormat": "p95" },
        { "refId": "C", "datasource": { "type": "prometheus", "uid": "prometheus" }, "expr": "histogram_quantile(0.99, sum by (le) (rate(conductor_inference_request_duration_seconds_bucket{api_family=~\"$api_family\"}[5m])))", "legendFormat": "p99" }
      ]
    },
    {
      "id": 8,
      "type": "timeseries",
      "title": "Time to first token percentiles",
      "gridPos": { "h": 8, "w": 12, "x": 12, "y": 14 },
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "fieldConfig": { "defaults": { "unit": "s", "custom": { "drawStyle": "line", "fillOpacity": 0 } }, "overrides": [] },
      "targets": [
        { "refId": "A", "datasource": { "type": "prometheus", "uid": "prometheus" }, "expr": "histogram_quantile(0.50, sum by (le) (rate(conductor_inference_first_token_duration_seconds_bucket{api_family=~\"$api_family\"}[5m])))", "legendFormat": "p50" },
        { "refId": "B", "datasource": { "type": "prometheus", "uid": "prometheus" }, "expr": "histogram_quantile(0.95, sum by (le) (rate(conductor_inference_first_token_duration_seconds_bucket{api_family=~\"$api_family\"}[5m])))", "legendFormat": "p95" }
      ]
    },
    {
      "id": 9,
      "type": "timeseries",
      "title": "Requests by response status",
      "gridPos": { "h": 8, "w": 12, "x": 0, "y": 22 },
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "fieldConfig": { "defaults": { "unit": "reqps", "custom": { "drawStyle": "line", "fillOpacity": 20, "stacking": { "mode": "normal" } } }, "overrides": [] },
      "targets": [
        { "refId": "A", "datasource": { "type": "prometheus", "uid": "prometheus" }, "expr": "sum by (http_status_code) (rate(conductor_inference_requests_total{api_family=~\"$api_family\"}[5m]))", "legendFormat": "{{http_status_code}}" }
      ]
    },
    {
      "id": 10,
      "type": "timeseries",
      "title": "Upstream errors by type",
      "gridPos": { "h": 8, "w": 12, "x": 12, "y": 22 },
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "fieldConfig": { "defaults": { "unit": "reqps", "custom": { "drawStyle": "line", "fillOpacity": 10 } }, "overrides": [] },
      "targets": [
        { "refId": "A", "datasource": { "type": "prometheus", "uid": "prometheus" }, "expr": "sum by (exception_type) (rate(conductor_inference_upstream_errors_total{api_family=~\"$api_family\"}[5m]))", "legendFormat": "{{exception_type}}" }
      ]
    }
  ]
}
